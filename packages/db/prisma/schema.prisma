  developer    Developer    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, localId])
  @@index([orgId, developerId, startedAt])
  @@index([orgId, flowSignature, startedAt])
  @@map("signals_sessions")
}

model LocalWorkSession {
  id             String    @id @default(cuid())
  orgId          String    @map("org_id")
  developerId    String    @map("developer_id")
  deviceId       String    @map("device_id")
  localId        String    @map("local_id")
  toolName       String    @map("tool_name")
  model          String?
  mode           String?
  title          String?
  tldr           String?
  overview       String?
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  observedAt     DateTime  @map("observed_at")
  toolCallCounts Json?     @map("tool_call_counts")
  trace          Json?
  repository     Json?
  source         String
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  developer    Developer    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, localId])
  @@index([orgId, observedAt])
  @@index([orgId, developerId, observedAt])
  @@index([orgId, toolName, observedAt])
  @@map("local_work_sessions")
}

model BillingPlanTemplate {
  id                         String    @id @default(cuid())
  orgId                      String    @map("org_id")
  provider                   String
  product                    String
  toolName                   String    @map("tool_name")
  name                       String
  tier                       String?
  toolKey                    String?   @map("tool_key")
  catalogPlanKey             String?   @map("catalog_plan_key")
  billingCadence             String    @default("monthly") @map("billing_cadence")
  usageWindowPreference      String    @default("auto") @map("usage_window_preference")
  billingCycleAnchorDate     DateTime? @map("billing_cycle_anchor_date") @db.Date
  billingCycleDays           Int?      @map("billing_cycle_days")
  billingProfile             String    @default("business") @map("billing_profile")
  seatCapacity               Int       @default(1) @map("seat_capacity")
  priceSource                String    @default("manual") @map("price_source")
  priceVerifiedAt            DateTime? @map("price_verified_at") @db.Date
  customPrice                Boolean   @default(true) @map("custom_price")
  providerSourceUrl          String?   @map("provider_source_url")
  currency                   String    @default("USD")
  cycleSeatMicros            BigInt    @default(0) @map("cycle_seat_micros")
  includedCycleMicros        BigInt    @default(0) @map("included_cycle_micros")
  inputRateMicrosPerMillion  BigInt    @default(0) @map("input_rate_micros_per_million")
  outputRateMicrosPerMillion BigInt    @default(0) @map("output_rate_micros_per_million")
  cacheRateMicrosPerMillion  BigInt    @default(0) @map("cache_rate_micros_per_million")
  billingOwner               String?   @map("billing_owner")
  externalReference          String?   @map("external_reference")
  notes                      String?   @db.Text
  active                     Boolean   @default(true)
  createdByUserId            String    @map("created_by_user_id")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments  DeveloperPlanAssignment[]

  @@index([orgId, active])
  @@index([orgId, toolKey, active])
  @@index([orgId, billingProfile])
  @@map("billing_plan_templates")
}

model DeveloperPlanAssignment {
  id                         String    @id @default(cuid())
  orgId                      String    @map("org_id")
  developerId                String    @map("developer_id")
  planTemplateId             String    @map("plan_template_id")
  provider                   String
  product                    String
  toolName                   String    @map("tool_name")
  planName                   String    @map("plan_name")
  planTier                   String?   @map("plan_tier")
  currency                   String    @default("USD")
  billingCadence             String    @default("monthly") @map("billing_cadence")
  billingCycleAnchorDate     DateTime? @map("billing_cycle_anchor_date") @db.Date
  billingCycleDays           Int?      @map("billing_cycle_days")
  cycleSeatMicros            BigInt    @default(0) @map("cycle_seat_micros")
  includedCycleMicros        BigInt    @default(0) @map("included_cycle_micros")
  inputRateMicrosPerMillion  BigInt    @default(0) @map("input_rate_micros_per_million")
  outputRateMicrosPerMillion BigInt    @default(0) @map("output_rate_micros_per_million")
  cacheRateMicrosPerMillion  BigInt    @default(0) @map("cache_rate_micros_per_million")
  billingOwner               String?   @map("billing_owner")
  externalReference          String?   @map("external_reference")
  seatCount                  Int       @default(1) @map("seat_count")
  seatStatus                 String    @default("active") @map("seat_status")
  startDate                  DateTime  @map("start_date") @db.Date
  endDate                    DateTime? @map("end_date") @db.Date
  active                     Boolean   @default(true)
  source                     String    @default("admin_confirmed")
  vendorAccountEmail         String?   @map("vendor_account_email")
  notes                      String?   @db.Text
  createdByUserId            String    @map("created_by_user_id")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  developer    Developer           @relation(fields: [developerId], references: [id], onDelete: Cascade)
  template     BillingPlanTemplate @relation(fields: [planTemplateId], references: [id], onDelete: Restrict)

  @@index([orgId, developerId, toolName, startDate, endDate])
  @@index([orgId, startDate, endDate])
  @@map("developer_plan_assignments")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String   @map("org_id")
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

/// Global control-plane key/value settings (cron seals, feature flags).
model AppRuntimeSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("app_runtime_settings")
}

/// Per-user, per-workspace email digest preferences (defaults on when missing).
model UserNotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  orgId                String   @map("org_id")
  dailyPersonalEnabled Boolean  @default(true) @map("daily_personal_enabled")
  dailyOrgEnabled      Boolean  @default(true) @map("daily_org_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("user_notification_preferences")
}

/// Idempotency log for 19:00 local daily report emails.
model DailyReportDelivery {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  orgId     String   @map("org_id")
  kind      String
  localDate String   @map("local_date")
  status    String   @default("success")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, kind, localDate])
  @@index([orgId, localDate])
  @@map("daily_report_deliveries")
}

/// Cumulative usage captured at daily-report send time (19:00 local) for fair deltas.
model DailyReportUsageSnapshot {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  /// Empty string = org-wide team report; otherwise personal developer scope.
  developerId String   @default("") @map("developer_id")
  localDate   String   @map("local_date")
  sendHour    Int      @default(19) @map("send_hour")
  tokens      BigInt   @default(0)
  costMicros  BigInt   @default(0) @map("cost_micros")
  requests    Int      @default(0)
  capturedAt  DateTime @map("captured_at")
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, developerId, localDate])
  @@index([orgId, localDate])
  @@map("daily_report_usage_snapshots")
}

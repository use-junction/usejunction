/// Server-tracked usage sync session (replaces client-only fingerprint drain).
model SyncRun {
  id                 String    @id @default(cuid())
  orgId              String    @map("org_id")
  deviceId           String    @map("device_id")
  kind               String    @default("usage")
  status             String    @default("open") // open | receiving | committed | failed
  expectedChunks     Int       @default(0) @map("expected_chunks")
  receivedChunks     Int       @default(0) @map("received_chunks")
  expectedRows       Int       @default(0) @map("expected_rows")
  receivedRows       Int       @default(0) @map("received_rows")
  manifestHash       String?   @map("manifest_hash")
  /// JSON array of partition keys expected in this run (delta set).
  deltaPartitions    Json      @default("[]") @map("delta_partitions")
  /// JSON array of all partition keys in the lookback manifest (authoritative for reconciliation).
  manifestPartitions Json      @default("[]") @map("manifest_partitions")
  windowFrom         DateTime? @map("window_from") @db.Date
  windowTo           DateTime? @map("window_to") @db.Date
  error              String?
  startedAt          DateTime  @default(now()) @map("started_at")
  committedAt        DateTime? @map("committed_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  chunks       SyncChunk[]

  @@index([orgId, deviceId, status])
  @@index([deviceId, startedAt])
  @@map("sync_runs")
}


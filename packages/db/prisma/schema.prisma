generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                         String    @id @default(cuid())
  name                       String
  slug                       String    @unique @default(cuid())
  color                      String?
  plan                       String    @default("community")
  subscriptionStatus         String?   @map("subscription_status")
  lemonSqueezyCustomerId     String?   @map("lemon_squeezy_customer_id")
  lemonSqueezySubscriptionId String?   @map("lemon_squeezy_subscription_id")
  lemonSqueezyVariantId      String?   @map("lemon_squeezy_variant_id")
  lemonSqueezyQuantity       Int?      @map("lemon_squeezy_quantity")
  billingEmail               String?   @map("billing_email")
  currentPeriodEnd           DateTime? @map("current_period_end")
  createdAt                  DateTime  @default(now()) @map("created_at")

  developers                Developer[]
  memberships               OrganizationMembership[]
  devices                   Device[]
  toolInstallations         ToolInstallation[]
  localModels               LocalModel[]
  requestMetadata           RequestMetadata[]
  enrollmentTokens          EnrollmentToken[]
  toolAccounts              ToolAccount[]
  accountCollectionEvents   AccountCollectionEvent[]
  quotaSnapshots            QuotaSnapshot[]
  quotaObservations         QuotaObservation[]
  planInterests             PlanInterest[]
  domains                   OrganizationDomain[]
  invites                   OrganizationInvite[]
  teamInviteLinks           TeamInviteLink[]
  providerConnections       ProviderConnection[]
  providerSyncRuns          ProviderSyncRun[]
  providerCapabilities      ProviderConnectionCapability[]
  providerSourceRecords     ProviderSourceRecord[]
  apiCreditPools            ApiCreditPool[]
  providerApiKeys           ProviderApiKey[]
  externalIdentities        ExternalIdentity[]
  seatAssignments           SeatAssignment[]
  repositories              Repository[]
  usageDaily                UsageDaily[]
  orgUsageDaySnapshots      OrgUsageDaySnapshot[]
  analyticsDirtyDays        AnalyticsDirtyDay[]
  analyticsWatermarks       AnalyticsWatermark[]
  syncRuns                  SyncRun[]
  syncRequests              SyncRequest[]
  deviceSyncRequestTargets  DeviceSyncRequestTarget[]
  deviceUsageFingerprints   DeviceUsageFingerprint[]
  toolClaims                DeveloperToolClaim[]
  billingPlanTemplates      BillingPlanTemplate[]
  planAssignments           DeveloperPlanAssignment[]
  telemetryEndpoint         TelemetryEndpoint?
  signalsPolicies           SignalsPolicy[]
  signalsActivityEvents     SignalsActivityEvent[]
  signalsSessions           SignalsSession[]
  localWorkSessions         LocalWorkSession[]
  auditLogs                 AuditLog[]
  agentUpdateDeployments    AgentUpdateDeployment[]
  agentUpdateEvents         AgentUpdateEvent[]
  activitySettings          ActivitySettings?
  deviceActivityEvents      DeviceActivityEvent[]
  notificationPreferences   UserNotificationPreference[]
  dailyReportDeliveries     DailyReportDelivery[]
  dailyReportUsageSnapshots DailyReportUsageSnapshot[]
  deviceRecoveryNotices     DeviceRecoveryNotice[]

  @@map("organizations")
}

model Developer {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  name       String
  email      String
  authUserId String?   @map("auth_user_id")
  role       String    @default("user")
  removedAt  DateTime? @map("removed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organization          Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  devices               Device[]
  toolInstallations     ToolInstallation[]
  localModels           LocalModel[]
  requestMetadata       RequestMetadata[]
  toolAccounts          ToolAccount[]
  authUser              User?                     @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  enrollmentTokens      EnrollmentToken[]
  externalIdentities    ExternalIdentity[]
  providerApiKeys       ProviderApiKey[]
  seatAssignments       SeatAssignment[]
  toolClaims            DeveloperToolClaim[]
  planAssignments       DeveloperPlanAssignment[]
  usageDaily            UsageDaily[]
  signalsActivityEvents SignalsActivityEvent[]
  signalsSessions       SignalsSession[]
  localWorkSessions     LocalWorkSession[]
  deviceActivityEvents  DeviceActivityEvent[]
  syncRequests          SyncRequest[]

  @@unique([orgId, email])
  @@unique([orgId, authUserId])
  @@index([orgId, removedAt])
  @@map("users")
}

model Device {
  id                  String    @id @default(cuid())
  orgId               String    @map("org_id")
  userId              String    @map("user_id")
  hostname            String
  os                  String
  architecture        String
  agentVersion        String    @map("agent_version")
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at")
  deviceToken         String    @unique @map("device_token")
  deviceTokenHash     String?   @unique @map("device_token_hash")
  localEndpoint       String?   @map("local_endpoint")
  localSyncTokenHash  String?   @map("local_sync_token_hash")
  localSyncTokenEnc   String?   @map("local_sync_token_enc")
  remoteSyncProtocol  Int       @default(0) @map("remote_sync_protocol")
  lastUsageSyncAt     DateTime? @map("last_usage_sync_at")
  lastAccountSyncAt   DateTime? @map("last_account_sync_at")
  lastToolsSyncAt     DateTime? @map("last_tools_sync_at")
  lastQuotasSyncAt    DateTime? @map("last_quotas_sync_at")
  toolsContentHash    String?   @map("tools_content_hash")
  accountsContentHash String?   @map("accounts_content_hash")
  quotasContentHash   String?   @map("quotas_content_hash")
  decommissionedAt    DateTime? @map("decommissioned_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  organization            Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                    Developer                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolInstallations       ToolInstallation[]
  localModels             LocalModel[]
  requestMetadata         RequestMetadata[]
  toolAccounts            ToolAccount[]
  accountCollectionEvents AccountCollectionEvent[]
  quotaSnapshots          QuotaSnapshot[]
  quotaObservations       QuotaObservation[]
  usageDaily              UsageDaily[]
  syncRuns                SyncRun[]
  syncChunks              SyncChunk[]
  deviceUsageFingerprints DeviceUsageFingerprint[]
  signalsActivityEvents   SignalsActivityEvent[]
  signalsSessions         SignalsSession[]
  localWorkSessions       LocalWorkSession[]
  agentUpdateDeployments  AgentUpdateDeployment[]
  agentUpdateEvents       AgentUpdateEvent[]
  deviceActivityEvents    DeviceActivityEvent[]
  syncRequestTargets      DeviceSyncRequestTarget[]
  recoveryNotices         DeviceRecoveryNotice[]
  repairEnrollmentTokens  EnrollmentToken[]

  @@map("devices")
}

model SyncRequest {
  id              String    @id @default(cuid())
  orgId           String    @map("org_id")
  requesterUserId String?   @map("requester_user_id")
  scope           String
  trigger         String    @default("manual")
  automationKey   String?   @unique @map("automation_key")
  developerId     String?   @map("developer_id")
  idempotencyKey  String?   @map("idempotency_key")
  realtimeChannel String?   @map("realtime_channel")
  dispatchStatus  String    @default("pending") @map("dispatch_status")
  dispatchError   String?   @map("dispatch_error") @db.Text
  publishedAt     DateTime? @map("published_at")
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  developer    Developer?                @relation(fields: [developerId], references: [id], onDelete: SetNull)
  targets      DeviceSyncRequestTarget[]

  @@index([orgId, createdAt])
  @@index([orgId, requesterUserId, idempotencyKey, createdAt])
  @@index([orgId, scope, createdAt])
  @@index([expiresAt])
  @@map("sync_requests")
}

model DeviceRecoveryNotice {
  id                 String    @id @default(cuid())
  orgId              String    @map("org_id")
  deviceId           String    @map("device_id")
  lastSeenAtSnapshot DateTime  @map("last_seen_at_snapshot")
  status             String    @default("pending")
  attemptCount       Int       @default(0) @map("attempt_count")
  sentAt             DateTime? @map("sent_at")
  recoveredAt        DateTime? @map("recovered_at")
  lastError          String?   @map("last_error") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, lastSeenAtSnapshot])
  @@index([orgId, status, createdAt])
  @@index([deviceId, recoveredAt])
  @@map("device_recovery_notices")
}

model DeviceSyncRequestTarget {
  id             String    @id @default(cuid())
  requestId      String    @map("request_id")
  orgId          String    @map("org_id")
  deviceId       String    @map("device_id")
  status         String    @default("queued")
  leaseToken     String?   @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attemptCount   Int       @default(0) @map("attempt_count")
  claimedAt      DateTime? @map("claimed_at")
  runningAt      DateTime? @map("running_at")
  completedAt    DateTime? @map("completed_at")
  toolsCount     Int?      @map("tools_count")
  accountsCount  Int?      @map("accounts_count")
  quotasCount    Int?      @map("quotas_count")
  usageRowsCount Int?      @map("usage_rows_count")
  warnings       Json?
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  syncRequest  SyncRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([requestId, deviceId])
  @@index([deviceId, status, leaseExpiresAt])
  @@index([orgId, status, createdAt])
  @@index([requestId, status])
  @@map("device_sync_request_targets")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AgentRelease {
  id               String    @id @default(cuid())
  version          String    @unique
  status           String    @default("candidate")
  urgency          String    @default("normal")
  rolloutHours     Int       @default(24) @map("rollout_hours")
  publishedAt      DateTime  @map("published_at")
  rolloutStartedAt DateTime? @map("rollout_started_at")
  manifest         Json
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  deployments AgentUpdateDeployment[]

  @@index([status, rolloutStartedAt])
  @@map("agent_releases")
}

model AgentUpdateDeployment {
  id                   String    @id @default(cuid())
  releaseId            String    @map("release_id")
  orgId                String    @map("org_id")
  deviceId             String    @map("device_id")
  sourceVersion        String    @map("source_version")
  targetVersion        String    @map("target_version")
  eligibleAt           DateTime  @map("eligible_at")
  /// True for devices snapshotted at promote time. Late joiners get rows with false
  /// so they still receive OTA without changing the fixed coverage denominator.
  cohortMember         Boolean   @default(true) @map("cohort_member")
  state                String    @default("pending")
  directiveDeliveredAt DateTime? @map("directive_delivered_at")
  downloadStartedAt    DateTime? @map("download_started_at")
  downloadedAt         DateTime? @map("downloaded_at")
  installStartedAt     DateTime? @map("install_started_at")
  confirmedAt          DateTime? @map("confirmed_at")
  failedAt             DateTime? @map("failed_at")
  rolledBackAt         DateTime? @map("rolled_back_at")
  attemptCount         Int       @default(0) @map("attempt_count")
  lastErrorStage       String?   @map("last_error_stage")
  lastErrorCode        String?   @map("last_error_code")
  lastEventAt          DateTime? @map("last_event_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  release      AgentRelease       @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  events       AgentUpdateEvent[]

  @@unique([releaseId, deviceId])
  @@index([orgId, releaseId, state])
  @@index([deviceId, createdAt])
  @@index([releaseId, cohortMember])
  @@map("agent_update_deployments")
}

model AgentUpdateEvent {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  deploymentId   String   @map("deployment_id")
  orgId          String   @map("org_id")
  deviceId       String   @map("device_id")
  eventType      String   @map("event_type")
  currentVersion String?  @map("current_version")
  targetVersion  String   @map("target_version")
  stage          String?
  errorCode      String?  @map("error_code")
  createdAt      DateTime @default(now()) @map("created_at")

  deployment   AgentUpdateDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, eventId])
  @@index([deploymentId, createdAt])
  @@index([orgId, createdAt])
  @@map("agent_update_events")
}

model ToolInstallation {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  userId        String   @map("user_id")
  deviceId      String   @map("device_id")
  toolName      String   @map("tool_name")
  detected      Boolean  @default(false)
  configured    Boolean  @default(false)
  configPath    String?  @map("config_path")
  version       String?
  lastCheckedAt DateTime @default(now()) @map("last_checked_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         Developer    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, toolName])
  @@map("tool_installations")
}

model LocalModel {
  id         String   @id @default(cuid())
  orgId      String   @map("org_id")
  userId     String   @map("user_id")
  deviceId   String   @map("device_id")
  provider   String
  modelName  String   @map("model_name")
  size       String?
  running    Boolean  @default(false)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         Developer    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, provider, modelName])
  @@map("local_models")
}

model RequestMetadata {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  userId        String?  @map("user_id")
  deviceId      String?  @map("device_id")
  toolName      String?  @map("tool_name")
  provider      String?
  model         String?
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  totalTokens   Int      @default(0) @map("total_tokens")
  estimatedCost Float    @default(0) @map("estimated_cost")
  latencyMs     Int      @default(0) @map("latency_ms")
  status        String   @default("success")
  traceId       String?  @map("trace_id")
  source        String   @default("gateway")
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         Developer?   @relation(fields: [userId], references: [id])
  device       Device?      @relation(fields: [deviceId], references: [id])

  @@index([orgId, createdAt])
  @@index([userId])
  @@index([model])
  @@index([toolName])
  @@map("request_metadata")
}

model EnrollmentToken {
  id             String    @id @default(cuid())
  orgId          String    @map("org_id")
  developerId    String?   @map("developer_id")
  repairDeviceId String?   @map("repair_device_id")
  tokenHash      String    @unique @map("token_hash")
  tokenReveal    String?   @map("token_reveal") @db.Text
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  developer    Developer?   @relation(fields: [developerId], references: [id], onDelete: Cascade)
  repairDevice Device?      @relation(fields: [repairDeviceId], references: [id], onDelete: Cascade)

  @@index([repairDeviceId, usedAt])
  @@map("enrollment_tokens")
}

model ToolAccount {
  id                 String   @id @default(cuid())
  orgId              String   @map("org_id")
  userId             String   @map("user_id")
  deviceId           String   @map("device_id")
  toolName           String   @map("tool_name")
  accountKey         String   @default("") @map("account_key")
  email              String?
  plan               String?
  loginMethod        String   @default("unknown") @map("login_method")
  authPresent        Boolean  @default(false) @map("auth_present")
  usageEnabled       Boolean  @default(false) @map("usage_enabled")
  loggingEnabled     Boolean  @default(false) @map("logging_enabled")
  usageAdminLocked   Boolean  @default(false) @map("usage_admin_locked")
  loggingAdminLocked Boolean  @default(false) @map("logging_admin_locked")
  updatedAt          DateTime @default(now()) @map("updated_at")

  organization     Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             Developer                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           Device                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  collectionEvents AccountCollectionEvent[]

  @@unique([deviceId, toolName, accountKey])
  @@index([orgId, toolName, email])
  @@map("tool_accounts")
}

model AccountCollectionEvent {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  deviceId      String   @map("device_id")
  toolAccountId String?  @map("tool_account_id")
  toolName      String   @map("tool_name")
  accountKey    String   @map("account_key")
  stream        String
  enabled       Boolean
  actor         String
  actorId       String?  @map("actor_id")
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  toolAccount  ToolAccount? @relation(fields: [toolAccountId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([deviceId, toolName, accountKey, createdAt])
  @@map("account_collection_events")
}

model QuotaSnapshot {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  deviceId         String?   @map("device_id")
  toolName         String    @map("tool_name")
  windowType       String    @map("window_type")
  usedPercent      Float?    @map("used_percent")
  resetAt          DateTime? @map("reset_at")
  creditsRemaining Float?    @map("credits_remaining")
  source           String    @default("cli_rpc")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, toolName, windowType])
  @@map("quota_snapshots")
}

model QuotaObservation {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  deviceId     String   @map("device_id")
  toolName     String   @map("tool_name")
  windowType   String   @map("window_type")
  resetAt      DateTime @map("reset_at")
  usedPercent  Float    @map("used_percent")
  observedAt   DateTime @default(now()) @map("observed_at")
  sampleBucket DateTime @map("sample_bucket")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, toolName, windowType, resetAt, sampleBucket])
  @@index([orgId, toolName, windowType, resetAt, observedAt])
  @@index([deviceId, observedAt])
  @@map("quota_observations")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  /// IANA timezone (e.g. Asia/Colombo). Used for 19:00 local daily reports.
  timeZone       String?   @map("time_zone")
  timeZoneSource String?   @map("time_zone_source")
  timeZoneManual Boolean   @default(false) @map("time_zone_manual")
  createdAt      DateTime  @default(now()) @map("created_at")

  accounts                Account[]
  sessions                Session[]
  memberships             OrganizationMembership[]
  actionTokens            AuthActionToken[]
  planInterests           PlanInterest[]
  developerProfiles       Developer[]
  notificationPreferences UserNotificationPreference[]
  dailyReportDeliveries   DailyReportDelivery[]

  @@map("auth_users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

model OrganizationMembership {
  id                        String    @id @default(cuid())
  userId                    String    @map("user_id")
  orgId                     String    @map("org_id")
  role                      String    @default("user")
  onboardingCompletedAt     DateTime? @map("onboarding_completed_at")
  setupChecklistDismissedAt DateTime? @map("setup_checklist_dismissed_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("organization_memberships")
}

model AuthActionToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("auth_action_tokens")
}

model PlanInterest {
  id        String   @id @default(cuid())
  plan      String
  email     String
  name      String?
  company   String?
  message   String?
  status    String   @default("new")
  userId    String?  @map("user_id")
  orgId     String?  @map("org_id")
  createdAt DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([email, plan])
  @@map("plan_interests")
}

model OrganizationDomain {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  domain           String    @unique
  verificationHash String    @map("verification_hash")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("organization_domains")
}

model OrganizationInvite {
  id              String    @id @default(cuid())
  orgId           String    @map("org_id")
  email           String
  role            String    @default("user")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
